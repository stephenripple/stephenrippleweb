---
// Generates a raked-gravel (karesansui) field: parallel rake lines that give
// way to concentric ripples around each stone. Built at compile time — no JS.
type Stone = { x: number; y: number; rx: number; ry: number; rings: number; path: string };
interface Props { layout?: 'wide' | 'tall' }
const { layout = 'wide' } = Astro.props;

// Stone outlines, drawn at their real size (half-width ≈ rx).
const BIG = 'M-62,14 C-70,-10 -40,-46 -6,-48 C30,-50 66,-28 64,4 C62,30 30,42 -4,40 C-36,38 -56,32 -62,14 Z';
const MID = 'M-40,8 C-44,-14 -18,-32 8,-30 C34,-28 46,-10 42,8 C38,24 14,30 -8,28 C-28,26 -38,20 -40,8 Z';
const SMALL = 'M-28,6 C-30,-10 -12,-22 6,-20 C24,-18 32,-6 28,6 C24,18 8,22 -6,20 C-20,18 -27,14 -28,6 Z';

const W = layout === 'wide' ? 1600 : 400;
const H = layout === 'wide' ? 720 : 860;
const tallStones: Stone[] = [
  { x: 300, y: 700, rx: 46, ry: 30, rings: 5, path: MID },
  { x: 80, y: 800, rx: 32, ry: 22, rings: 4, path: SMALL },
];
const wideStones: Stone[] = [
  {
    x: 1180, y: 300, rx: 70, ry: 44, rings: 7,
    path: 'M-62,14 C-70,-10 -40,-46 -6,-48 C30,-50 66,-28 64,4 C62,30 30,42 -4,40 C-36,38 -56,32 -62,14 Z',
  },
  {
    x: 1420, y: 560, rx: 46, ry: 30, rings: 6,
    path: 'M-40,8 C-44,-14 -18,-32 8,-30 C34,-28 46,-10 42,8 C38,24 14,30 -8,28 C-28,26 -38,20 -40,8 Z',
  },
  {
    x: 930, y: 590, rx: 32, ry: 22, rings: 5,
    path: 'M-28,6 C-30,-10 -12,-22 6,-20 C24,-18 32,-6 28,6 C24,18 8,22 -6,20 C-20,18 -27,14 -28,6 Z',
  },
];
const stones = layout === 'wide' ? wideStones : tallStones;

const gap = 14; // spacing between rake lines and ripples

// Horizontal rake lines, masked out wherever a stone's ripples are.
const lines: number[] = [];
for (let y = gap; y < H; y += gap) lines.push(y);

const ringsFor = (s: Stone) =>
  Array.from({ length: s.rings }, (_, i) => ({
    rx: s.rx + 14 + i * gap,
    ry: s.ry + 14 + i * gap * 0.62,
    i,
  }));
---

<svg
  class:list={["garden", layout]}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio={layout === "wide" ? "xMaxYMid slice" : "xMidYMax slice"}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <mask id={`rake-mask-${layout}`} maskUnits="userSpaceOnUse">
      <rect width={W} height={H} fill="white" />
      {stones.map((s) => {
        const outer = ringsFor(s).at(-1)!;
        return <ellipse cx={s.x} cy={s.y} rx={outer.rx + gap / 2} ry={outer.ry + gap / 2} fill="black" />;
      })}
    </mask>
  </defs>

  <g class="rake" mask={`url(#rake-mask-${layout})`}>
    {lines.map((y) => <line x1="0" x2={W} y1={y} y2={y} />)}
  </g>

  {stones.map((s, si) => (
    <g transform={`translate(${s.x} ${s.y})`}>
      {ringsFor(s).map((r) => (
        <ellipse
          class="ring"
          rx={r.rx}
          ry={r.ry}
          style={`--d:${si * 140 + r.i * 90}ms`}
        />
      ))}
      <ellipse class="moss" rx={s.rx * 1.12} ry={s.ry * 0.9} cx={s.rx * 0.06} cy={s.ry * 0.3} />
      <path class="stone" d={s.path} />
    </g>
  ))}
</svg>

<style>
  .garden {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .tall { display: none; }
  @media (max-width: 700px) {
    .wide { display: none; }
    .tall { display: block; }
  }
  .rake line,
  .ring {
    fill: none;
    stroke: var(--rake);
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .moss {
    fill: var(--moss);
    opacity: 0.45;
  }
  .stone {
    fill: var(--stone);
  }
  .ring {
    transform-box: fill-box;
    transform-origin: center;
    animation: ripple 1100ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--d);
  }
  @keyframes ripple {
    from {
      opacity: 0;
      transform: scale(0.82);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ring {
      animation: none;
    }
  }
</style>
